# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_chatbot
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration
# Embedding models:
#   - text-embedding-3-small (1536 dims, cheaper, good performance)
#   - text-embedding-3-large (3072 dims, best performance)
#   - text-embedding-ada-002 (1536 dims, legacy)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat model (any current OpenAI chat model works, e.g. gpt-4.1-mini, gpt-4.1).
# Note: OpenAI has shut down gpt-4-turbo-preview, and gpt-4-turbo / gpt-3.5-turbo shut down on 2026-10-23.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# OpenAI Generation Parameters
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=1000

# Alternative AI Providers (optional)
# Anthropic Claude (for LLM)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere (alternative for embeddings)
# COHERE_API_KEY=your_cohere_api_key_here

# RAG Configuration
EMBEDDING_DIMENSION=1536
# text-embedding-3-small similarity scores are usually 0.2-0.6, so keep this low
SIMILARITY_THRESHOLD=0.2
MAX_SOURCES=5

# Security
# Required to use POST /api/chat/ingest (send as "Authorization: Bearer <key>").
# Leave empty to disable the ingest endpoint.
ADMIN_API_KEY=
# Max chat requests per client IP per window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
# Set to the number of reverse proxies in front of the backend (e.g. 1 on Render)
# so rate limiting sees real client IPs. Leave empty when not behind a proxy.
TRUST_PROXY=